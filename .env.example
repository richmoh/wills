# Postgres
DATABASE_URL=postgres://localhost:5432/wasiyyah_dev

# Random 32+ byte secret used to hash session tokens (openssl rand -hex 32)
SESSION_SECRET=change-me

# Canonical URL of the deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email via Resend (optional in development — the message is printed to the
# server console instead of being sent). Needed in production for password resets.
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "Wasiyyah <no-reply@example.org>"
EMAIL_FROM=

# Stripe (optional in development — the upgrade is simulated when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional pre-created Price id; if unset an ad-hoc GBP price is used
STRIPE_PRICE_ID=
# One-time price of the Complete Will Pack, in pence
PREMIUM_PRICE_PENCE=3900
